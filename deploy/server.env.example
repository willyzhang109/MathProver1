# /etc/mathprover/server.env    chmod 0600, owned root:mathprover
# Every value here is read by server/config.py.

# --- credentials ------------------------------------------------------------
# Rotate the key that was previously hardcoded in the prover scripts: it is in
# this repository's git history and must be treated as burned.
GEMINI_API_KEY=replace-me

# --- paths ------------------------------------------------------------------
LAKE_ROOT=/srv/mathprover/MathProverProject
RUNS_DIR=/srv/mathprover/MathProverProject/runs
PROVER_PYTHON=/srv/mathprover/MathProverProject/.venv/bin/python

# Call the built binaries directly. Going through `lake exe` would serialize
# every concurrent verification on the Lake workspace lock.
SAFEVERIFY_BIN=/srv/mathprover/MathProverProject/SafeVerify/.lake/build/bin/safe_verify
SAFEVERIFY_LEAN_CMD=lean

# --- capacity ---------------------------------------------------------------
# Each concurrent job forks PROVER_NUM_PROCS provers, each holding Mathlib.
# Start conservative and raise only after watching real RSS.
MAX_CONCURRENT_JOBS=5
PROVER_NUM_PROCS=2
JOB_TIMEOUT_SECONDS=1200
CHECKER_POOL_SIZE=3
PER_IP_RUNNING=1
PER_IP_QUEUED=2

# --- limits -----------------------------------------------------------------
RATE_LIMIT_JOB=3
RATE_LIMIT_FORMALIZE=10
RATE_LIMIT_CHECK=20
RATE_WINDOW_SECONDS=3600
# IP limits are defeated by any VPN; this is the real cost control.
MAX_JOBS_PER_DAY=60

# --- http -------------------------------------------------------------------
CORS_ORIGINS=https://willyzhang109.github.io
# Only addresses listed here may set X-Forwarded-For. Must match the reverse
# proxy, and nothing else.
TRUSTED_PROXIES=127.0.0.1/32,::1/128

# --- misc -------------------------------------------------------------------
# NOTE: do not set LEAN_CC="clang -O1". Lake execs LEAN_CC as a single
# program name, so a value with arguments fails with
#   could not execute external process 'clang -O1'
# It would also be pointless: Lake appends -O3 after it, and the last
# optimisation flag wins. Leave it unset to use Lean's bundled clang.
