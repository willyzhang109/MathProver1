# Local shell variables for the GCP runbook (deploy/docker/README.md).
#
#   cp deploy/gcp.env.example deploy/gcp.env   # gitignored
#   edit DOMAIN, then:  source deploy/gcp.env
#
# These live ONLY in your terminal. Nothing on the server reads this file --
# it exists so the gcloud commands in the runbook can be pasted verbatim, and
# so the values survive opening a new terminal partway through.

# --- project ----------------------------------------------------------------
# Defaults to whatever gcloud is already pointed at, so it cannot silently stay
# a placeholder. Override by exporting PROJECT before sourcing this file.
export PROJECT="${PROJECT:-$(gcloud config get-value project 2>/dev/null)}"
export REGION="${REGION:-us-central1}"
export ZONE="${ZONE:-us-central1-a}"

# --- you must set this ------------------------------------------------------
# A hostname you control DNS for, pointing at the static IP from step 5.
# No domain of your own? Use sslip.io, which needs no signup or DNS record:
#   IP=$(gcloud compute addresses describe mathprover-ip \
#          --region=$REGION --format='value(address)')
#   export DOMAIN=api.${IP//./-}.sslip.io
export DOMAIN="${DOMAIN:-api.example.com}"

# Where the browser loads the site from -- not where the API lives.
export PAGES_ORIGIN="${PAGES_ORIGIN:-https://willyzhang109.github.io}"

# --- derived; do not edit ---------------------------------------------------
# NOTE: these are expanded now, not lazily. Fixing PROJECT after sourcing does
# NOT update them -- re-source the file instead.
export SA="mathprover-vm@$PROJECT.iam.gserviceaccount.com"
export IMAGE="$REGION-docker.pkg.dev/$PROJECT/mathprover/api:latest"

# --- refuse to leave placeholders in place ----------------------------------
_bad=""
[ -z "$PROJECT" ] && _bad="$_bad PROJECT(empty: run 'gcloud config set project ...')"
case "$PROJECT" in your-gcp-project) _bad="$_bad PROJECT(placeholder)";; esac
case "$DOMAIN" in api.example.com|api.yourdomain.com) _bad="$_bad DOMAIN(placeholder)";; esac
# A bare IP cannot work here: Let's Encrypt will not issue a certificate for an
# IP, so Caddy has no public cert and every HTTPS request fails the handshake.
case "$DOMAIN" in
  *[a-zA-Z]*) ;;
  *) _bad="$_bad DOMAIN(bare IP: needs a hostname you control DNS for)";;
esac
if [ -n "$_bad" ]; then
  echo "gcp.env: still unset or placeholder:$_bad" >&2
  echo "gcp.env: fix, then re-source this file (derived SA/IMAGE are stale)." >&2
else
  echo "gcp.env: PROJECT=$PROJECT REGION=$REGION ZONE=$ZONE DOMAIN=$DOMAIN"
  echo "gcp.env: SA=$SA"
  echo "gcp.env: IMAGE=$IMAGE"
fi
unset _bad

# NOTE: deploy/docker/cloudbuild.yaml defaults to the us-central1 registry.
# For another region, build with:
#   gcloud builds submit --config deploy/docker/cloudbuild.yaml . \
#     --substitutions=_REGION=$REGION
